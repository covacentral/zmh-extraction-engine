              {list.length === 0 && <div className="text-white/20 text-sm italic p-4 text-center border border-dashed border-white/10 rounded-xl">No hay tickets aquí</div>}
          </div>
      </div>
  );

  return (
    <div className="flex flex-col lg:flex-row min-h-screen">
