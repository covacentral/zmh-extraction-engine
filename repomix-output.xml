                            asesorName,
                            asesorSection,
                            orderContext: orderContext || {},
                            createdAt: new Date().toISOString()
                        });
                    } catch (err) {
                        console.error('Error saving premium metrics and rollups:', err);
                    }
                }

                res.json({ ok: true, msg: 'Ticket y Factura despachados exitosamente.' });
            });
        }
    } catch (e) {
